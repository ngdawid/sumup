<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>A query failed. Return an empty list and the reason, so the Products screen can show it.</description>
        <name>Set_Load_Error</name>
        <label>Set Load Error</label>
        <locationX>800</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>outEntries</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Products couldn&apos;t be loaded: {!$Flow.FaultMessage}</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_No_Family_Products</name>
        <label>Set No Family Products</label>
        <locationX>500</locationX>
        <locationY>450</locationY>
        <assignmentItems>
            <assignToReference>outMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No products left to add in this family.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Price_Book_Empty</name>
        <label>Set Price Book Empty</label>
        <locationX>50</locationX>
        <locationY>450</locationY>
        <assignmentItems>
            <assignToReference>outMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The price book has no active products. Contact your Salesforce admin.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <constants>
        <description>Most rows returned to the Products table. Newest products come first.</description>
        <name>conMaxEntries</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>200.0</numberValue>
        </value>
    </constants>
    <decisions>
        <name>Family_Empty</name>
        <label>Family Empty?</label>
        <locationX>300</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Has entries</defaultConnectorLabel>
        <rules>
            <name>No_Family_Entries</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outEntries</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_No_Family_Products</targetReference>
            </connector>
            <label>Empty</label>
        </rules>
    </decisions>
    <decisions>
        <name>Family_Selected</name>
        <label>Family Selected?</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Get_Entries_Family</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>One family</defaultConnectorLabel>
        <rules>
            <name>All_Families</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxAllFamilies</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Entries_All</targetReference>
            </connector>
            <label>All families</label>
        </rules>
    </decisions>
    <decisions>
        <name>Price_Book_Empty</name>
        <label>Price Book Empty?</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Has entries</defaultConnectorLabel>
        <rules>
            <name>Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>outEntries</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inCart</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Price_Book_Empty</targetReference>
            </connector>
            <label>Empty</label>
        </rules>
    </decisions>
    <description>Screen action for Partner Sales: New Opportunity with Products. Returns up to conMaxEntries active entries (active entry and active product) of the given price book, newest first, for one Product Family or all families (blank inFamily), leaving out products already added. Query errors are returned in outMessage.</description>
    <environments>Default</environments>
    <formulas>
        <description>True when no family is given (null or empty): show all families.</description>
        <name>fxAllFamilies</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!inFamily})</expression>
    </formulas>
    <interviewLabel>Partner Sales: Get Available Entries {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Partner Sales: Get Available Entries</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Entries_All</name>
        <label>Get Entries (all families)</label>
        <locationX>50</locationX>
        <locationY>250</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Price_Book_Empty</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Load_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricebook2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inPricebookId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsProductActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotIn</operator>
            <value>
                <elementReference>Cart_Ids</elementReference>
            </value>
        </filters>
        <limit>
            <elementReference>conMaxEntries</elementReference>
        </limit>
        <object>PricebookEntry</object>
        <outputReference>outEntries</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ProductCode</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_Entries_Family</name>
        <label>Get Entries (one family)</label>
        <locationX>300</locationX>
        <locationY>250</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Family_Empty</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Load_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricebook2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inPricebookId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsProductActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ProductFamily__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inFamily</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotIn</operator>
            <value>
                <elementReference>Cart_Ids</elementReference>
            </value>
        </filters>
        <limit>
            <elementReference>conMaxEntries</elementReference>
        </limit>
        <object>PricebookEntry</object>
        <outputReference>outEntries</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>ProductCode</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Cart_Ids</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <transforms>
        <name>Cart_Ids</name>
        <label>Cart Ids</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <connector>
            <targetReference>Family_Selected</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <elementReference>inCart[$EachItem].Id</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <description>Products already added; they are left out of the result.</description>
        <name>inCart</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <description>Product Family to show. Blank means all families.</description>
        <name>inFamily</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inPricebookId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outEntries</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <name>outMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
